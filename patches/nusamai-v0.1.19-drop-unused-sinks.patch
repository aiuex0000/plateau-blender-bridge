-    let dy = end[1] - start[1];
-    let mut enter = 0.0_f64;
-    let mut exit = 1.0_f64;
-
-    for (p, q) in [
-        (-dx, start[0] - min_x),
-        (dx, max_x - start[0]),
-        (-dy, start[1] - min_y),
-        (dy, max_y - start[1]),
-    ] {
-        if p == 0.0 {
-            if q < 0.0 {
-                return None;
-            }
-            continue;
-        }
-
-        let ratio = q / p;
-        if p < 0.0 {
-            if ratio > exit {
-                return None;
-            }
-            enter = enter.max(ratio);
