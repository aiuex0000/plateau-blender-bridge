-fn push_fragment(fragments: &mut Vec<Vec<[f64; 2]>>, current: &mut Vec<[f64; 2]>) {
-    if current.len() >= 2 {
-        fragments.push(std::mem::take(current));
-    } else {
-        current.clear();
-    }
-}
